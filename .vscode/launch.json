{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BarroControl Web",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "toolArgs": ["--web-port=5173", "--dart-define=API_BASE_URL=http://localhost:8080"]
    },
    {
      "name": "BarroControl Android (emulador)",
      "request": "launch",
      "type": "dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://10.0.2.2:8080"]
    },
    {
      "name": "BarroControl Negocios (vista previa)",
      "request": "launch",
      "type": "dart",
      "program": "lib/negocios_preview.dart",
      "deviceId": "chrome",
      "toolArgs": ["--web-port=5174", "--dart-define=NEGOCIOS_PREVIEW=${input:negociosPreview}"]
    },
    {
      "name": "BarroControl Áreas y categorías (vista previa)",
      "request": "launch",
      "type": "dart",
      "program": "lib/areas_categorias_preview.dart",
      "deviceId": "chrome",
      "toolArgs": ["--web-port=5175", "--dart-define=AREAS_CATEGORIAS_PREVIEW=${input:areasCategoriasPreview}"]
    }
  ],
  "inputs": [
    {
      "id": "negociosPreview",
      "type": "pickString",
      "description": "Escenario visual de negocios",
      "options": ["vacio", "lista", "registro", "completo", "validacion", "editar", "guardado", "eliminar"],
      "default": "lista"
    },
    {
      "id": "areasCategoriasPreview",
      "type": "pickString",
      "description": "Escenario visual de áreas y categorías",
      "options": ["inicio", "vacio", "lista", "registrar", "registro_validacion", "sucursal_unica", "sucursales", "categorias_vacias", "categorias", "registrar_categoria", "categoria_validacion", "editar_datos", "editar_sucursales", "editar_categoria", "detalle", "area_guardada", "area_editada", "categoria_guardada", "categoria_editada", "categoria_eliminada", "area_eliminada", "confirmar_area", "confirmar_categoria"],
      "default": "lista"
    }
  ]
}
